--cpu Cortex-M3
"node_sensor\startup_stm32f103xb.o"
"node_sensor\main.o"
"node_sensor\gpio.o"
"node_sensor\can.o"
"node_sensor\i2c.o"
"node_sensor\usart.o"
"node_sensor\stm32f1xx_it.o"
"node_sensor\stm32f1xx_hal_msp.o"
"node_sensor\stm32f1xx_hal_gpio_ex.o"
"node_sensor\stm32f1xx_hal_can.o"
"node_sensor\stm32f1xx_hal.o"
"node_sensor\stm32f1xx_hal_rcc.o"
"node_sensor\stm32f1xx_hal_rcc_ex.o"
"node_sensor\stm32f1xx_hal_gpio.o"
"node_sensor\stm32f1xx_hal_dma.o"
"node_sensor\stm32f1xx_hal_cortex.o"
"node_sensor\stm32f1xx_hal_pwr.o"
"node_sensor\stm32f1xx_hal_flash.o"
"node_sensor\stm32f1xx_hal_flash_ex.o"
"node_sensor\stm32f1xx_hal_exti.o"
"node_sensor\stm32f1xx_hal_i2c.o"
"node_sensor\stm32f1xx_hal_uart.o"
"node_sensor\system_stm32f1xx.o"
--library_type=microlib --strict --scatter "Node_Sensor\Node_Sensor.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "Node_Sensor.map" -o Node_Sensor\Node_Sensor.axf